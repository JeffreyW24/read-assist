# Copy this file to .env.local and paste your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: which Gemini model to use (defaults to the latest Flash model)
# GEMINI_MODEL=gemini-flash-latest

# ---- Only needed when the site is hosted (see DEPLOY.md) ----
# Hosted database (Turso). Leave unset locally: the app uses data/read-assist.db.
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=
# Secret used to sign login cookies. Any long random string (e.g. run: openssl rand -hex 32).
# AUTH_SECRET=

# The one-click demo accounts (Prof. Rivera, Sam Student) and their sample course.
# On by default on your laptop, off by default on a hosted site. Set to 1 to turn them on
# when hosted (anyone with the link can then sign in to them), or 0 to turn them off locally.
# DEMO_ACCOUNTS=1
